# Server Environment Variables – Student REST API
PORT=3000

# MongoDB Atlas Connection String (for local development without Docker)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/student_db?retryWrites=true&w=majority

# MongoDB Docker Container Connection String (for Docker / Docker Compose)
# MONGODB_URI=mongodb://mongodb:27017/student_db
