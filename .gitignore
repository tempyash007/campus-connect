.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
Assignment-Lab-7.pdf

# Diagnostic / temporary outputs & build zips
*.zip
*.tmp
*.temp
.cache/