apiVersion: v1
kind: Secret
metadata:
  name: microservices-secret
  namespace: lab8
  labels:
    app.kubernetes.io/part-of: campus-connect
type: Opaque
stringData:
  # Replace with your external MongoDB Atlas connection URI or local Mongo URI
  # Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/campus_connect?retryWrites=true&w=majority
  MONGODB_URI: "mongodb://localhost:27017/campus_connect"
