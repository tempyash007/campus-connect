# ============================================================
# .dockerignore – Lab 6 Microservices Stack
# Files and directories to exclude from Docker build context
# ============================================================

# Node.js dependencies
**/node_modules
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variable files (secrets)
.env
.env.*
!.env.example

# Version control & IDE files
.git
.gitignore
.vscode
.idea
.DS_Store
Thumbs.db

# Documentation & Assignment PDF
*.pdf
README.md

# Testing & Screenshots
screenshot/
postman/

# Client & Mobile Apps (not needed for backend container builds)
student-android/
student-client/

# Logs & temp files
logs
*.log
